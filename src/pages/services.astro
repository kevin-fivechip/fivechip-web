---
import CallToAction from "../components/CallToAction.astro";
import Container from "../components/Container.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { services, site } from "../site";

const engagements = [
  {
    title: "Discovery",
    text: "Working sessions with your teams that end in a clear problem statement and a recommendation.",
  },
  {
    title: "Projects",
    text: "Architecture and implementation, delivered in small steps you can review.",
  },
  {
    title: "Advisory",
    text: "Architecture reviews, AI training for your team, or help getting a stalled project moving.",
  },
];
---

<BaseLayout
  title="Services"
  description={`Discovery, architecture and implementation, project leadership, and AI with guardrails from ${site.name}.`}
>
<PageHeader
    eyebrow="Services"
    title="Define the problem. Then build the solution."
    intro="Every engagement starts with the people who use, support, and depend on the system. I listen, observe, and work with your teams to define the real problem, establish what success looks like, and only then architect and build the solution."
/>

  <section class="py-16 sm:py-20">
    <Container>
      <div class="space-y-6">
        {
          services.map((service) => (
            <article
              id={service.id}
              class="grid scroll-mt-24 gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8 lg:grid-cols-2 lg:gap-12"
            >
              <div>
                <span class="inline-flex size-11 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                  <Icon name={service.icon} />
                </span>
                <h2 class="mt-5 text-2xl font-semibold tracking-tight">{service.title}</h2>
                <p class="mt-3 text-lg leading-8 text-slate-600">{service.summary}</p>
              </div>
              <ul class="space-y-3 self-center">
                {service.points.map((point) => (
                  <li class="flex gap-3">
                    <Icon name="check" class="mt-1 size-5 shrink-0 text-brand-600" />
                    <span class="leading-7">{point}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </Container>
  </section>

  <section class="border-t border-slate-200 bg-slate-50 py-16 sm:py-20" aria-labelledby="engagements-heading">
    <Container>
      <div class="max-w-2xl">
        <p class="eyebrow">Ways to work together</p>
        <h2 id="engagements-heading" class="mt-2 text-3xl font-semibold tracking-tight sm:text-4xl">
          Start small. Grow from there.
        </h2>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {
          engagements.map((engagement) => (
            <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
              <h3 class="text-lg font-semibold">{engagement.title}</h3>
              <p class="mt-2 leading-7 text-slate-600">{engagement.text}</p>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <CallToAction />
</BaseLayout>
