---
import Container from "../components/Container.astro";
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { contactHref, site } from "../site";

const helpful = [
  "What's going wrong, and who it affects",
  "What it costs today",
  "Your timeline",
];
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.name} about a software problem, a new project, or one that's stalled.`}
>
  <section class="py-16 sm:py-24" aria-labelledby="contact-heading">
    <Container class="grid gap-12 lg:grid-cols-5 lg:gap-16">
      <div class="lg:col-span-3">
        <p class="eyebrow">Contact</p>
        <h1 id="contact-heading" class="mt-4 text-4xl sm:text-5xl">Tell me about the problem.</h1>
        <p class="mt-6 text-lg leading-8 text-stone-600">
          Not just the solution you have in mind. A few sentences is plenty, and messages go straight to my
          inbox.
        </p>
        <div class="mt-10 flex flex-col items-start gap-4">
          <a href={contactHref} class="btn-primary max-w-full">
            <Icon name="mail" class="size-5 shrink-0" />
            <span class="truncate">Email {site.email}</span>
          </a>
          <a
            href={site.linkedin}
            rel="me noopener"
            target="_blank"
            class="inline-flex items-center gap-2 text-sm font-medium text-stone-600 hover:text-brand-950"
          >
            <Icon name="linkedin" class="size-4" />
            Also on LinkedIn
            <Icon name="arrow-up-right" class="size-4" />
          </a>
        </div>
      </div>
      <aside class="self-start rounded-lg border border-stone-200 bg-paper p-6 sm:p-8 lg:col-span-2">
        <h2 class="font-sans text-lg font-semibold tracking-normal">Helpful to include</h2>
        <ul class="mt-4 divide-y divide-stone-200">
          {
            helpful.map((item) => (
              <li class="flex gap-3 py-3 first:pt-0 last:pb-0">
                <Icon name="check" class="mt-1 size-5 shrink-0 text-accent-600" />
                <span class="leading-7">{item}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </Container>
  </section>
</BaseLayout>
