---
import Container from "../components/Container.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../site";

// Update this date whenever the policy text changes.
const lastUpdated = "September 27, 2026";
---

<BaseLayout
  title="Privacy"
  description={`What ${site.name}'s website and applications collect, and how that information is used.`}
>
  <PageHeader
    eyebrow="Privacy"
    title="Privacy policy"
    intro={`Plain-language answers about what this website and ${site.name} applications collect.`}
  />

  <section class="py-16 sm:py-20">
    <Container>
      <div class="content max-w-3xl">
        <p class="text-sm text-slate-500">Last updated {lastUpdated}.</p>

        <h2>This website</h2>
        <ul>
          <li>This site doesn't use cookies, analytics, advertising, or tracking scripts.</li>
          <li>Its fonts and images are served from this site, not from third parties.</li>
          <li>
            The site is hosted on Google's Firebase Hosting, which keeps standard server logs (such as IP
            address, browser type, and the pages requested) to deliver the site and protect it from abuse.
            Google's handling of that data is covered by the <a href="https://policies.google.com/privacy"
              >Google Privacy Policy</a
            >.
          </li>
        </ul>

        <h2>Email</h2>
        <p>
          If you email me, I use your address and message only to reply and to keep a record of our
          conversation. I don't sell or share them.
        </p>

        <h2>{site.name} applications</h2>
        <p>
          Some applications on fivechip.com subdomains are private and available by invitation only. For
          those applications:
        </p>
        <ul>
          <li>
            Signing in with Google shares your name, email address, and profile picture with the application.
            They're used only to identify you and confirm that you've been invited. Google's sign-in button
            is provided by Google under the Google Privacy Policy.
          </li>
          <li>
            Information you enter is stored in Google Cloud and used only to provide the application to you.
            It isn't sold or shared with anyone else.
          </li>
          <li>One cookie keeps you signed in. It expires on its own, or when you sign out.</li>
          <li>
            To see or delete your information, email <a href={`mailto:${site.email}`}>{site.email}</a>.
          </li>
        </ul>

        <h2>Changes</h2>
        <p>If this policy changes, the date at the top of this page will change too.</p>

        <h2>Contact</h2>
        <p>Questions? Email <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
      </div>
    </Container>
  </section>
</BaseLayout>
