---
import Container from "../components/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="relative isolate overflow-hidden">
    <div aria-hidden="true" class="hero-grid absolute inset-0 -z-10"></div>
    <Container class="py-24 text-center sm:py-32">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Page not found</h1>
      <p class="mx-auto mt-6 max-w-md text-lg leading-8 text-slate-600">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a href="/" class="btn-primary mt-10">Back to home</a>
    </Container>
  </section>
</BaseLayout>
