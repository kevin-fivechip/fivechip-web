---
import Container from "../components/Container.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" noindex>
  <section class="bg-paper">
    <Container class="py-24 text-center sm:py-32">
      <p class="eyebrow justify-center">404</p>
      <h1 class="mt-4 text-4xl sm:text-5xl">Page not found</h1>
      <p class="mx-auto mt-6 max-w-md text-lg leading-8 text-stone-600">
        The page you're looking for doesn't exist or has moved.
      </p>
      <a href="/" class="btn-primary mt-10">Back to home</a>
    </Container>
  </section>
</BaseLayout>
