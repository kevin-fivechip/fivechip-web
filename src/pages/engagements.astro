---
import CallToAction from "../components/CallToAction.astro";
import Container from "../components/Container.astro";
import Icon from "../components/Icon.astro";
import PageHeader from "../components/PageHeader.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { services, site, technologies } from "../site";

// What a client can expect on any engagement, whatever its shape.
const expectations = [
  {
    title: "Straight talk",
    text: "If politics, budget, or technology is holding a project back, I'll say so, and bring options.",
  },
  {
    title: "Small, safe steps",
    text: "Working releases early, each with a way to roll back.",
  },
  {
    title: "You own everything",
    text: "Your code, your accounts, and your data. No lock-in.",
  },
];

const engagements = [
  {
    title: "Discovery",
    text: "Working sessions with your teams that end in a clear problem statement and a recommendation.",
  },
  {
    title: "Projects",
    text: "Architecture and implementation, delivered in small steps you can review.",
  },
  {
    title: "Advisory",
    text: "Architecture reviews, or AI training for your team if you need it.",
  },
];
---

<BaseLayout
  title="Engagements"
  description={`How an engagement with ${site.name} runs: discovery, architecture and implementation, keeping projects on track, and AI with guardrails.`}
>
  <PageHeader
    eyebrow="Engagements"
    title="Define the problems. Then build the solutions."
    intro="Every engagement starts with the people who use, support and depend on the existing systems, and your team stays involved through to the end so they understand, own and can evolve the result. Here is the work I take on, and the ways we can start."
  />

  <section class="py-4 sm:py-8">
    <Container>
      {
        services.map((service, index) => (
          <article
            id={service.id}
            class="grid scroll-mt-24 gap-6 border-b border-stone-200 py-12 last:border-b-0 sm:py-14 lg:grid-cols-[6rem_1fr_1fr] lg:gap-12"
          >
            <span class="font-serif text-4xl font-semibold tracking-tight text-accent-600" aria-hidden="true">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h2 class="text-2xl sm:text-3xl">{service.title}</h2>
              <p class="mt-4 text-lg leading-8 text-stone-600">{service.summary}</p>
            </div>
            <ul class="space-y-3 lg:pt-2">
              {service.points.map((point) => (
                <li class="flex gap-3">
                  <Icon name="check" class="mt-1 size-5 shrink-0 text-accent-600" />
                  <span class="leading-7">{point}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </Container>
  </section>

  <section class="border-t border-stone-200 py-16 sm:py-20" aria-labelledby="expect-heading">
    <Container>
      <div class="max-w-2xl">
        <p class="eyebrow">What you can expect</p>
        <h2 id="expect-heading" class="mt-4 text-3xl sm:text-4xl">How every engagement runs.</h2>
      </div>
      <ul class="mt-10 grid gap-x-12 gap-y-8 md:grid-cols-3">
        {
          expectations.map((item) => (
            <li class="border-t-2 border-accent-500 pt-5">
              <h3 class="text-lg font-semibold">{item.title}</h3>
              <p class="mt-2 leading-7 text-stone-600">{item.text}</p>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <section class="border-t border-stone-200 bg-paper py-16 sm:py-20" aria-labelledby="engagements-heading">
    <Container>
      <div class="max-w-2xl">
        <p class="eyebrow">Ways to work together</p>
        <h2 id="engagements-heading" class="mt-4 text-3xl sm:text-4xl">Start small. Grow from there.</h2>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          engagements.map((engagement) => (
            <div class="border-t-2 border-accent-500 pt-5">
              <h3 class="text-lg font-semibold">{engagement.title}</h3>
              <p class="mt-2 leading-7 text-stone-600">{engagement.text}</p>
            </div>
          ))
        }
      </div>
      <p class="mt-14 border-t border-stone-200 pt-6 text-sm leading-7 text-stone-600">
        <span class="font-semibold text-brand-950">Technologies I build with most:</span>
        {" "}{technologies.join(", ")}. However, the right tool is the one that fits your problem and your team.
      </p>
    </Container>
  </section>

  <CallToAction />
</BaseLayout>
