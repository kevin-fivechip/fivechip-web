---
/**
 * The second half of the legal discovery pipeline: canonical Markdown in,
 * the team's working documents out, with targeted local-model calls only
 * where they earn their place. Same conventions as DiscoveryPipelineCore.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const main = { x: 24, w: 252, h: 58 };
const side = { x: 296, w: 168 };
const gap = 22;

const steps = [
  { title: "canonical.md", sub: "Same shape for every document", input: true },
  { title: "5 · Keyword index", sub: "Team's list, plus flagged model hits" },
  { title: "6 · Diff and summary", sub: "Against the previous version" },
  { title: "7 · Unified case file", sub: "Every document on one timeline" },
];

let y = 50;
const placed = steps.map((step) => {
  const item = { ...step, y };
  y += main.h + gap;
  return item;
});

const outputsY = y + 8;
const outputs = [
  { title: "keywords.md", sub: "Hits, file and page" },
  { title: "diff.md", sub: "What changed, where" },
  { title: "unified.md", sub: "People and timeline" },
];
const outW = 138;
const outGap = 10;
const outH = 52;
const height = outputsY + outH + 24;
const cx = main.x + main.w / 2;

// The model box sits beside steps 5 to 7.
const modelTop = placed[1].y;
const modelBottom = placed[3].y + main.h;
---

<svg
  viewBox={`0 0 480 ${height}`}
  role="img"
  aria-labelledby="outputs-title"
  class:list={["h-auto w-full min-w-[28rem] font-sans", className]}
>
  <title id="outputs-title">
    Output pipeline: each canonical Markdown file feeds a keyword index, a diff against the previous version and
    a unified case file, with targeted calls to a small local model, producing keywords, diff and unified
    Markdown documents.
  </title>
  <defs>
    <marker id="out-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5 0 10z" class="fill-accent-500" />
    </marker>
  </defs>

  <rect x="8" y="8" width="464" height={height - 16} rx="8" class="fill-paper stroke-stone-300" stroke-dasharray="5 4" />
  <text x="24" y="30" class="fill-stone-500" font-size="11" font-style="italic">
    Still the same MacBook. Add steps as the team asks for them.
  </text>

  {
    placed.map((step, i) => (
      <>
        {i > 0 && (
          <line
            x1={cx}
            y1={step.y - gap + 2}
            x2={cx}
            y2={step.y - 3}
            class="stroke-accent-500"
            stroke-width="1.5"
            marker-end="url(#out-arrow)"
          />
        )}
        <rect
          x={main.x}
          y={step.y}
          width={main.w}
          height={main.h}
          rx="6"
          class:list={[step.input ? "fill-accent-50 stroke-accent-300" : "fill-white stroke-stone-300"]}
          stroke-width="1.25"
        />
        <text x={main.x + 14} y={step.y + 24} class="fill-brand-950" font-size="14" font-weight="600">
          {step.title}
        </text>
        <text x={main.x + 14} y={step.y + 44} class="fill-stone-600" font-size="12">
          {step.sub}
        </text>
      </>
    ))
  }

  <!-- Local model beside steps 5 to 7 -->
  <rect x={side.x} y={modelTop} width={side.w} height={modelBottom - modelTop} rx="6" class="fill-brand-50 stroke-brand-300" stroke-width="1.25" />
  <text x={side.x + 12} y={modelTop + 24} class="fill-brand-950" font-size="13" font-weight="600">Ollama, local</text>
  <text x={side.x + 12} y={modelTop + 44} class="fill-stone-600" font-size="11">qwen2.5 7B</text>
  <text x={side.x + 12} y={modelTop + 60} class="fill-stone-600" font-size="11">Targeted calls only</text>
  <text x={side.x + 12} y={modelTop + 76} class="fill-stone-600" font-size="11">Each hit cites its page</text>
  <text x={side.x + 12} y={modelTop + 92} class="fill-stone-600" font-size="11">Code does the rest</text>
  {
    placed.slice(1).map((step) => (
      <line
        x1={main.x + main.w + 4}
        y1={step.y + main.h / 2}
        x2={side.x - 4}
        y2={step.y + main.h / 2}
        class="stroke-accent-500"
        stroke-width="1.5"
        marker-start="url(#out-arrow)"
        marker-end="url(#out-arrow)"
      />
    ))
  }

  <!-- Outputs -->
  {
    outputs.map((out, i) => {
      const x = main.x + i * (outW + outGap);
      return (
        <>
          <line
            x1={cx}
            y1={placed[3].y + main.h + 2}
            x2={x + outW / 2}
            y2={outputsY - 3}
            class="stroke-accent-500"
            stroke-width="1.5"
            marker-end="url(#out-arrow)"
          />
          <rect x={x} y={outputsY} width={outW} height={outH} rx="6" class="fill-accent-50 stroke-accent-300" stroke-width="1.25" />
          <text x={x + 12} y={outputsY + 22} class="fill-brand-950" font-size="13" font-weight="600">
            {out.title}
          </text>
          <text x={x + 12} y={outputsY + 40} class="fill-stone-600" font-size="11">
            {out.sub}
          </text>
        </>
      );
    })
  }
</svg>
