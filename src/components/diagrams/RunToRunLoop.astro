---
/**
 * The run-to-run control loop in a wafer fab: a lot arrives, the control
 * system recommends settings from recent lots, the tool runs, metrology
 * measures, and the measurement feeds the next recommendation. Same
 * conventions as the other diagrams: inline SVG, site palette, vertical.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const main = { x: 24, w: 252, h: 58 };
const gap = 22;
const loopX = 300;
const noteX = 322;

const steps = [
  { title: "Tool controller", sub: "A lot arrives at the stepper. Asks for settings." },
  { title: "Control system: recommend", sub: "From recent lots of this product, y = f(x)", feedback: true },
  { title: "Stepper", sub: "Runs the lot with the recommended settings" },
  { title: "Metrology tool", sub: "Measures overlay on the finished wafers" },
  { title: "Data uploader", sub: "New records go to the control system as XML", source: true },
];

let y = 50;
const placed = steps.map((step) => {
  const item = { ...step, y };
  y += main.h + gap;
  return item;
});
const height = y - gap + 20;
const cx = main.x + main.w / 2;
const from = placed.find((s) => s.source)!;
const to = placed.find((s) => s.feedback)!;
---

<svg
  viewBox={`0 0 480 ${height}`}
  role="img"
  aria-labelledby="r2r-title"
  class:list={["h-auto w-full min-w-[28rem] font-sans", className]}
>
  <title id="r2r-title">
    Run-to-run control loop: the tool controller asks the control system for settings, the control system
    recommends them from recent lots, the stepper runs the lot, the metrology tool measures it, and the data
    uploader feeds the measurement back for the next recommendation.
  </title>
  <defs>
    <marker id="r2r-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5 0 10z" class="fill-accent-500" />
    </marker>
  </defs>

  <rect x="8" y="8" width="464" height={height - 16} rx="8" class="fill-paper stroke-stone-300" stroke-dasharray="5 4" />
  <text x="24" y="30" class="fill-stone-500" font-size="11" font-style="italic">
    One lot at a time, every lot, around the clock.
  </text>

  {
    placed.map((step, i) => (
      <>
        {i > 0 && (
          <line
            x1={cx}
            y1={step.y - gap + 2}
            x2={cx}
            y2={step.y - 3}
            class="stroke-accent-500"
            stroke-width="1.5"
            marker-end="url(#r2r-arrow)"
          />
        )}
        <rect
          x={main.x}
          y={step.y}
          width={main.w}
          height={main.h}
          rx="6"
          class:list={[step.feedback ? "fill-brand-50 stroke-brand-300" : "fill-white stroke-stone-300"]}
          stroke-width="1.25"
        />
        <text x={main.x + 14} y={step.y + 24} class="fill-brand-950" font-size="14" font-weight="600">
          {step.title}
        </text>
        <text x={main.x + 14} y={step.y + 44} class="fill-stone-600" font-size="12">
          {step.sub}
        </text>
      </>
    ))
  }

  <!-- Feedback: uploader back up to the recommendation -->
  <polyline
    points={`${main.x + main.w + 4},${from.y + main.h / 2} ${loopX},${from.y + main.h / 2} ${loopX},${to.y + main.h / 2} ${main.x + main.w + 6},${to.y + main.h / 2}`}
    fill="none"
    class="stroke-accent-500"
    stroke-width="1.5"
    marker-end="url(#r2r-arrow)"
  />
  <text x={noteX} y={to.y + 14} class="fill-brand-950" font-size="12" font-weight="600">Feedback</text>
  <text x={noteX} y={to.y + 32} class="fill-stone-600" font-size="11">Measured overlay becomes</text>
  <text x={noteX} y={to.y + 47} class="fill-stone-600" font-size="11">input for the next lot.</text>
  <text x={noteX} y={to.y + 74} class="fill-brand-950" font-size="12" font-weight="600">With grouping</text>
  <text x={noteX} y={to.y + 92} class="fill-stone-600" font-size="11">The next lot of any product</text>
  <text x={noteX} y={to.y + 107} class="fill-stone-600" font-size="11">in the group can use it.</text>
</svg>
