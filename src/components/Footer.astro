---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { nav, site } from "../site";

// Set at build time; every deploy refreshes it.
const year = new Date().getFullYear();
---

<footer class="border-t border-stone-200 bg-paper">
  <Container class="py-14">
    <div class="grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-6 text-stone-600">{site.description}</p>
      </div>
      <nav aria-label="Footer">
        <p class="text-xs font-semibold tracking-[0.18em] text-stone-500 uppercase">Site</p>
        <ul class="mt-4 space-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-stone-700 hover:text-brand-950">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/privacy" class="text-stone-700 hover:text-brand-950">Privacy</a>
          </li>
        </ul>
      </nav>
      <div>
        <p class="text-xs font-semibold tracking-[0.18em] text-stone-500 uppercase">Contact</p>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 font-medium text-brand-950 hover:text-accent-700">
              <Icon name="mail" class="size-4" />
              {site.email}
            </a>
          </li>
          <li>
            <a
              href={site.linkedin}
              rel="me noopener"
              target="_blank"
              class="inline-flex items-center gap-2 text-stone-700 hover:text-brand-950"
            >
              <Icon name="linkedin" class="size-4" />
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>
    <p class="mt-12 border-t border-stone-200 pt-6 text-sm text-stone-500">
      © {year} {site.name}. All rights reserved.
    </p>
  </Container>
</footer>
