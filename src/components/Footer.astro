---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { nav, site } from "../site";

// Set at build time; every deploy refreshes it.
const year = new Date().getFullYear();
---

<footer class="border-t border-slate-200 bg-slate-50">
  <Container class="py-12">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <Logo />
        <p class="mt-4 text-sm leading-6 text-slate-600">{site.description}</p>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 inline-flex items-center gap-2 text-sm font-medium text-slate-700 hover:text-brand-700"
        >
          <Icon name="mail" class="size-4" />
          {site.email}
        </a>
      </div>
      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-12 gap-y-3 text-sm">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="text-slate-600 hover:text-slate-900">
                  {item.label}
                </a>
              </li>
            ))
          }
          <li>
            <a href="/privacy" class="text-slate-600 hover:text-slate-900">Privacy</a>
          </li>
        </ul>
      </nav>
    </div>
    <p class="mt-10 border-t border-slate-200 pt-6 text-sm text-slate-500">
      © {year} {site.name}. All rights reserved.
    </p>
  </Container>
</footer>
