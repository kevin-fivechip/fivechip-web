---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { nav, site } from "../site";

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;
const current = (href: string) =>
  currentPath === href || currentPath.startsWith(`${href}/`) ? "page" : undefined;
// Contact is a button on wide screens and a plain link in the phone menu.
const desktopLinks = nav.filter((item) => item.href !== "/contact");
---

<header class="sticky top-0 z-40 border-b border-stone-200 bg-white/90 backdrop-blur-md">
  <Container class="flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="rounded-md focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-500"
      aria-label={`${site.name} home`}
    >
      <Logo />
    </a>

    <nav aria-label="Main" class="hidden items-center gap-1 lg:flex">
      {
        desktopLinks.map((item) => (
          <a
            href={item.href}
            aria-current={current(item.href)}
            class:list={[
              "border-b-2 px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors hover:text-brand-950",
              current(item.href) ? "border-accent-500 text-brand-950" : "border-transparent text-stone-600",
            ]}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/contact" aria-current={current("/contact")} class="btn-primary ml-4 px-4 py-2 text-sm whitespace-nowrap">
        Get in touch
      </a>
    </nav>

    <details class="group relative lg:hidden">
      <summary
        class="flex size-10 cursor-pointer list-none items-center justify-center rounded-md text-brand-950 hover:bg-paper focus-visible:outline-2 focus-visible:outline-accent-500 [&::-webkit-details-marker]:hidden"
        aria-label="Menu"
      >
        <Icon name="menu" class="size-6 group-open:hidden" />
        <Icon name="close" class="hidden size-6 group-open:block" />
      </summary>
      <nav
        aria-label="Main"
        class="absolute right-0 mt-2 w-60 rounded-lg border border-stone-200 bg-white p-2 shadow-lg"
      >
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={current(item.href)}
              class:list={[
                "block rounded-md px-3 py-2.5 text-base font-medium hover:bg-paper",
                current(item.href) ? "text-accent-700" : "text-brand-950",
              ]}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
    </details>
  </Container>
</header>
