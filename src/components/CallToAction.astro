---
import Container from "./Container.astro";
import Icon from "./Icon.astro";
import { contactHref, site } from "../site";
---

<section class="bg-brand-950 py-16 sm:py-20" aria-labelledby="cta-heading">
  <Container class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-center lg:gap-16">
    <div class="max-w-2xl">
      <p class="eyebrow text-accent-300 before:bg-accent-400">Get in touch</p>
      <h2 id="cta-heading" class="mt-4 text-3xl text-white sm:text-4xl">Tell me what isn't working.</h2>
      <p class="mt-4 text-lg leading-8 text-brand-200">
        No formal brief required. A few sentences about the problem, who it affects and what it costs today
        is enough to start a useful conversation.
      </p>
    </div>
    <div class="flex flex-col items-start gap-4 lg:items-end">
      <a href={contactHref} class="btn-inverse max-w-full">
        <Icon name="mail" class="size-5 shrink-0" />
        <span class="truncate">Email {site.email}</span>
      </a>
      <a
        href={site.linkedin}
        rel="me noopener"
        target="_blank"
        class="inline-flex items-center gap-2 text-sm font-medium text-brand-300 hover:text-white"
      >
        or find me on LinkedIn
        <Icon name="arrow-up-right" class="size-4" />
      </a>
    </div>
  </Container>
</section>
