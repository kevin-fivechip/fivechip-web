---
import Container from "./Container.astro";

interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
}

const { eyebrow, title, intro } = Astro.props;
---

<section class="relative isolate overflow-hidden border-b border-slate-200 bg-slate-50">
  <div aria-hidden="true" class="hero-grid absolute inset-0 -z-10 opacity-80"></div>
  <Container class="py-16 sm:py-20">
    <div class="max-w-3xl">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 class="mt-2 text-4xl font-semibold tracking-tight sm:text-5xl">{title}</h1>
      {intro && <p class="mt-6 text-lg leading-8 text-slate-600">{intro}</p>}
    </div>
  </Container>
</section>
